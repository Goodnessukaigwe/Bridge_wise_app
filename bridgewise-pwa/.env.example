# Copy this file to .env.local in this same folder (gitignored).
# Never put GEMINI_API_KEY in client code. It is used only by the server routes
# src/app/api/agent (assistant) and src/app/api/parse (draft fallback).

# Google AI Studio, server-side only. Set the same name in Vercel (Production + Preview).
# Do not prefix with NEXT_PUBLIC_. Do not add Stripe, maps, WhatsApp Business, or Supabase keys.
#
# Use a key from a Cloud project with billing switched on (the paid tier). On the free tier
# Google may use prompts and replies to improve its products; on the paid tier it does not.
# Customer chats are pasted into this app, so the paid tier is strongly recommended.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash; the route falls back to gemini-3.5-flash if it is retired.
# AGENT_MODEL=
