# Copy this file to .env.local in this same folder (gitignored).
# Never put GEMINI_API_KEY in client code — it is used only in src/app/api/parse.

# Google AI Studio, server-side only. Set the same name in Vercel (Production + Preview).
# Do not prefix with NEXT_PUBLIC_. Do not add Stripe, maps, WhatsApp Business, or Supabase keys.
GEMINI_API_KEY=
